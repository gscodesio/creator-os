# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/creator_os?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Cloudinary Media Configuration (Server-Only)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Email Provider Configuration (Optional for production email delivery)
# Option A: Resend API Key
RESEND_API_KEY=""
EMAIL_FROM="Creator OS <noreply@creator-os.app>"

# Option B: SMTP Provider
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Node Environment & Port
PORT=3000
NODE_ENV="development"
